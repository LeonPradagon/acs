generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String            @id @default(uuid())
  email           String            @unique
  password        String
  name            String?
  role            String            @default("user") // "superadmin", "admin", "user"
  divisionId      String?
  division        Division?         @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  clearanceLevel  Int               @default(1) // 1: Staff, 2: Supervisor, 3: Manager, etc.
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  documents       Document[]
  emailConnection EmailConnection?
  tokenUsages     TokenUsage[]
}

model Document {
  id             String          @id @default(uuid())
  title          String
  content        String
  category       String?
  classification String?
  tags           String[]
  metadata       Json?
  status         String          @default("COMPLETED") // PENDING, PROCESSING, COMPLETED, FAILED
  userId         String? // Ownership for private docs (like emails)
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  divisionId     String? // Division ownership, if null it's considered a Global document
  division       Division?       @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  clearanceLevel Int             @default(1)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  chunks         DocumentChunk[]
}

/// Stores individual text chunks with vector embeddings for pgvector search.
/// The "embedding" column (vector(384)) is added via raw SQL migration.
model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String
  chunkIndex Int
  createdAt  DateTime @default(now())
  embedding  Unsupported("vector(384)")?

  @@index([documentId])
}

model ChatSession {
  id            String        @id @default(uuid())
  title         String        @default("New Chat")
  userId        String?
  onyxSessionId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  messages      ChatHistory[]

  @@index([userId])
}

model ChatHistory {
  id        String        @id @default(uuid())
  sessionId String
  session   ChatSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  files     Json?
  createdAt DateTime      @default(now())
  feedback  ChatFeedback?

  @@index([sessionId])
  @@index([createdAt])
}

model ChatFeedback {
  id        String      @id @default(uuid())
  messageId String      @unique
  message   ChatHistory @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String?
  rating    String // "thumbs_up" or "thumbs_down"
  comment   String?
  createdAt DateTime    @default(now())
}

/// Stores encrypted OAuth tokens for email integration (Outlook/Microsoft Graph).
/// Tokens are encrypted with AES-256-GCM before storage.
model EmailConnection {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String   @default("microsoft") // "microsoft" | "google" (future)
  encryptedTokens String   // AES-256-GCM encrypted JSON {accessToken, refreshToken, expiresAt}
  email           String   // Connected email address (e.g. user@outlook.com)
  scopes          String[] // Granted OAuth scopes
  connectedAt     DateTime @default(now())
  lastSyncAt      DateTime?
  status          String   @default("active") // "active" | "expired" | "revoked"
}

model Division {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  users       User[]
  documents   Document[]
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ==========================================
// MOCK ERP DATABASE (Testing only)
// ==========================================
model ErpEmployee {
  id           String      @id @default(uuid())
  firstName    String
  lastName     String
  divisionName String
  jobTitle     String
  hireDate     DateTime
  status       String      @default("ACTIVE") // ACTIVE, INACTIVE
  salaries     ErpSalary[]
}

model ErpSalary {
  id             String      @id @default(uuid())
  employeeId     String
  employee       ErpEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  baseSalary     Float
  allowance      Float       @default(0)
  currency       String      @default("IDR")
  effectiveDate  DateTime
}

model TokenUsage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens    Int
  model     String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
