generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String            @id @default(uuid())
  email           String            @unique
  password        String
  name            String?
  role            String            @default("user") // "superadmin", "admin", "user"
  divisionId      String?
  division        Division?         @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  clearanceLevel  Int               @default(1) // 1: Staff, 2: Supervisor, 3: Manager, etc.
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  documents       Document[]
  emailConnection EmailConnection?
  tokenUsages     TokenUsage[]
}

model Document {
  id             String          @id @default(uuid())
  title          String
  content        String
  category       String?
  classification String?
  tags           String[]
  metadata       Json?
  status         String          @default("COMPLETED") // PENDING, PROCESSING, COMPLETED, FAILED
  userId         String? // Ownership for private docs (like emails)
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  divisionId     String? // Division ownership, if null it's considered a Global document
  division       Division?       @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  clearanceLevel Int             @default(1)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  
  // Knowledge Lifecycle Management
  version        Int             @default(1)
  deletedAt      DateTime?       // Soft delete
  checksum       String?         // Document hash for duplicate detection
  lineage        Json?           // Tracing document origin/updates

  chunks         DocumentChunk[]
  knowledgeGraphNodes KnowledgeGraphNode[]
  embeddingJobs  EmbeddingJob[]
}

/// Stores individual text chunks with vector embeddings for pgvector search.
/// The "embedding" column (vector(384)) is added via raw SQL migration.
model DocumentChunk {
  id             String   @id @default(uuid())
  documentId     String
  content        String   @db.Text
  chunkIndex     Int
  
  // Advanced Recursive Chunking Metadata
  heading        String?  // Optional header of the section
  pageNumber     Int?     // Optional page number
  sectionPath    String?  // e.g. "Chapter 1 > Section 1.2"
  checksum       String?  // Hash to prevent re-indexing unchanged chunks
  
  // Vector search uses pgvector via raw queries
  embedding      Unsupported("vector(384)")?
  
  createdAt      DateTime @default(now())

  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  @@index([documentId])
}

model ChatSession {
  id            String        @id @default(uuid())
  title         String        @default("New Chat")
  userId        String?
  onyxSessionId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  messages      ChatHistory[]
  summaries     ConversationSummary[]

  @@index([userId])
}

model ChatHistory {
  id        String        @id @default(uuid())
  sessionId String
  session   ChatSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  files     Json?
  createdAt DateTime      @default(now())
  feedback  ChatFeedback?

  @@index([sessionId])
  @@index([createdAt])
}

model ChatFeedback {
  id        String      @id @default(uuid())
  messageId String      @unique
  message   ChatHistory @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String?
  rating    String // "thumbs_up" or "thumbs_down"
  comment   String?
  createdAt DateTime    @default(now())
}

/// Stores encrypted OAuth tokens for email integration (Outlook/Microsoft Graph).
/// Tokens are encrypted with AES-256-GCM before storage.
model EmailConnection {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String   @default("microsoft") // "microsoft" | "google" (future)
  encryptedTokens String   // AES-256-GCM encrypted JSON {accessToken, refreshToken, expiresAt}
  email           String   // Connected email address (e.g. user@outlook.com)
  scopes          String[] // Granted OAuth scopes
  connectedAt     DateTime @default(now())
  lastSyncAt      DateTime?
  status          String   @default("active") // "active" | "expired" | "revoked"
}

model Division {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  users       User[]
  documents   Document[]
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ==========================================
// MOCK ERP DATABASE (Testing only)
// ==========================================
model ErpEmployee {
  id           String      @id @default(uuid())
  firstName    String
  lastName     String
  divisionName String
  jobTitle     String
  hireDate     DateTime
  status       String      @default("ACTIVE") // ACTIVE, INACTIVE
  salaries     ErpSalary[]
}

model ErpSalary {
  id             String      @id @default(uuid())
  employeeId     String
  employee       ErpEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  baseSalary     Float
  allowance      Float       @default(0)
  currency       String      @default("IDR")
  effectiveDate  DateTime
}

model TokenUsage {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens          Int      // Total tokens
  promptTokens    Int      @default(0)
  completionTokens Int     @default(0)
  model           String?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}

model PromptVersion {
  id        String   @id @default(uuid())
  name      String   // e.g., "SYSTEM_PROMPT", "RAG_PROMPT"
  version   Int      // e.g., 1, 2, 3
  content   String   @db.Text
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, version])
}

model TraceLog {
  id        String   @id @default(uuid())
  traceId   String   @db.VarChar(100)
  spanId    String   @db.VarChar(100)
  parentId  String?  @db.VarChar(100)
  name      String   // e.g., "HTTP GET /chat", "LLM Invoke", "DB Query"
  status    String   // "SUCCESS", "ERROR"
  durationMs Int
  metadata  Json?
  error     String?  @db.Text
  createdAt DateTime @default(now())

  @@index([traceId])
  @@index([createdAt])
  @@index([name])
}

model SystemMetrics {
  id        String   @id @default(uuid())
  name      String   // e.g., "latency_avg", "error_rate", "active_users"
  value     Float
  unit      String   // e.g., "ms", "%", "count"
  timestamp DateTime @default(now())

  @@index([name, timestamp])
}

model EvaluationResult {
  id              String   @id @default(uuid())
  chatSessionId   String?
  question        String   @db.Text
  answer          String   @db.Text
  contextUsed     Json?
  relevancyScore  Float    // 0.0 to 1.0
  faithfulness    Float    // 0.0 to 1.0
  feedback        String?  @db.Text
  modelUsed       String   // e.g. "gpt-oss:120b-cloud"
  createdAt       DateTime @default(now())

  @@index([chatSessionId])
  @@index([createdAt])
}

// ============================================================
// Phase 3: AI Memory Models
// ============================================================

/// Stores a condensed summary of past conversations to provide long-term context
model ConversationSummary {
  id          String   @id @default(uuid())
  sessionId   String
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  summary     String   @db.Text
  createdAt   DateTime @default(now())
  
  @@index([sessionId])
}

/// Stores extracted entities (names, organizations, specific facts) linked to a user/session
model EntityMemory {
  id          String   @id @default(uuid())
  userId      String?
  entityType  String   // e.g. "PERSON", "ORGANIZATION", "PROJECT", "PREFERENCE"
  entityName  String
  entityValue String   @db.Text
  confidence  Float    @default(1.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId])
}

// ============================================================
// Phase 3: Knowledge Graph (Graph RAG)
// ============================================================

model KnowledgeGraphNode {
  id          String   @id @default(uuid())
  documentId  String?
  document    Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  entityType  String   // e.g. "PERSON", "PROJECT", "TECHNOLOGY"
  entityName  String   @unique
  properties  Json?
  createdAt   DateTime @default(now())
  
  sourceEdges KnowledgeGraphEdge[] @relation("SourceNode")
  targetEdges KnowledgeGraphEdge[] @relation("TargetNode")
  
  @@index([documentId])
  @@index([entityName])
}

model KnowledgeGraphEdge {
  id           String   @id @default(uuid())
  sourceNodeId String
  targetNodeId String
  relationType String   // e.g. "WORKS_FOR", "DEPENDS_ON", "IMPLEMENTED_IN"
  properties   Json?
  createdAt    DateTime @default(now())

  sourceNode   KnowledgeGraphNode @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode   KnowledgeGraphNode @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([sourceNodeId, targetNodeId, relationType])
  @@index([sourceNodeId])
  @@index([targetNodeId])
}

// ============================================================
// Phase 3: Knowledge Lifecycle Management
// ============================================================

model EmbeddingJob {
  id          String   @id @default(uuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  status      String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  progress    Int      @default(0)
  error       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([documentId])
  @@index([status])
}
